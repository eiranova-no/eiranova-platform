# Supabase (hentes fra docs/ENVIRONMENTS.md per miljø)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase CLI / config.toml (supabase/.env — ikke Next.js-appene)
# [auth].site_url + [auth.email.smtp].pass
# Prod (wxyfwgxvfhpicmcpknxt):    SUPABASE_AUTH_SITE_URL=https://app.eiranova.no
# Staging (hlenyzppjodmkoaugzid): SUPABASE_AUTH_SITE_URL=https://staging.app.eiranova.no
# Lokal (kunde-app :3001):        SUPABASE_AUTH_SITE_URL=http://127.0.0.1:3001
SUPABASE_AUTH_SITE_URL=http://127.0.0.1:3001

# Miljø-identifikasjon
NEXT_PUBLIC_APP_ENV=development   # development | preview | production
NEXT_PUBLIC_DATA_SOURCE=dev       # dev | prod
